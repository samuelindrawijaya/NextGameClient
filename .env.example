# Optional: public catalog count. Use the public anon key; never a service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Admin server credentials. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional existing public.user ID for actor_user_id / created_by.
ADMIN_ACTOR_USER_ID=
# Required for live Assets: app_id (Steam AppID) or id (game_lists identity).
ADMIN_ASSET_ID_KIND=
# Set the public origin when HTTPS is terminated by a reverse proxy.
ADMIN_APP_ORIGIN=
# Preview is automatically available in development only.
ADMIN_ALLOW_PREVIEW=false
